# Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME="AutobahnCV - Car License Plate Search"
DEBUG=False
API_PREFIX="/api/v1"
ML_STRICT_STARTUP=False
# Keep False for plate search: missing detector weights should fail loudly.
ML_ALLOW_HEURISTIC_PLATE_FALLBACK=False
# If car detection misses, use the original image as the car crop.
ML_ALLOW_FULL_IMAGE_CAR_FALLBACK=True
# Optional local/container directory for cropped car/plate debug images.
ML_DEBUG_IMAGE_DIR=

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=cars
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# S3 / MinIO Storage (S3-compatible, Garage alternative)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=Q3AM3UQ867SPQQA43P2F
S3_SECRET_KEY=zuf+tfteSlswRu7BJ86wekitnifILbZam1KYY3TG
S3_BUCKET_NAME=autobahncv
S3_REGION=us-east-1
S3_IMAGE_PREFIX=cars/
S3_USE_SSL=False

# Neuron 1: YOLO - Car detection
NEURON1_CAR_DETECTION_MODEL=/app/models/car_detector.pt
NEURON1_CONFIDENCE_THRESHOLD=0.25

# Neuron 2: YOLO - License plate detection
# Provide custom Russian license-plate detector weights here.
NEURON2_PLATE_DETECTION_MODEL=/app/models/license_plate_detector.pt
NEURON2_CONFIDENCE_THRESHOLD=0.5

# Neuron 3: OCR - License plate text recognition
NEURON3_OCR_MODEL=/app/models/plate_ocr.pt
NEURON3_CONFIDENCE_THRESHOLD=0.45

# Neuron 4: ResNet - Embedding generation
NEURON4_RESNET_MODEL=/app/models/car_embedder.pt
NEURON4_EMBEDDING_DIM=2048

# Neuron 5: CLIP - search by text description ("белая Toyota Camry, номер А1**ВС77")
# If the models cannot be loaded, the app starts without text search.
TEXT_SEARCH_ENABLED=True
NEURON5_CLIP_IMAGE_MODEL=clip-ViT-B-32
NEURON5_CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
NEURON5_CLIP_EMBEDDING_DIM=512

# Search Configuration
SEARCH_TOP_K=5
EMBEDDING_SIMILARITY_THRESHOLD=0.7
# Share of the description score in photo + description search (0..1)
HYBRID_DESCRIPTION_WEIGHT=0.5
