# Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME="AutobahnCV - Car License Plate Search"
DEBUG=False
API_PREFIX="/api/v1"

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=cars
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# S3 / MinIO Storage (S3-compatible, Garage alternative)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=Q3AM3UQ867SPQQA43P2F
S3_SECRET_KEY=zuf+tfteSlswRu7BJ86wekitnifILbZam1KYY3TG
S3_BUCKET_NAME=autobahncv
S3_REGION=us-east-1
S3_IMAGE_PREFIX=cars/
S3_USE_SSL=False

# Neuron 1: YOLO v8 - Car detection
NEURON1_CAR_DETECTION_MODEL=yolov8x.pt
NEURON1_CONFIDENCE_THRESHOLD=0.5

# Neuron 2: YOLO v8 - License plate detection
NEURON2_PLATE_DETECTION_MODEL=yolov8_plate.pt
NEURON2_CONFIDENCE_THRESHOLD=0.5

# Neuron 3: OCR - License plate text recognition
NEURON3_OCR_MODEL=ocr_model
NEURON3_CONFIDENCE_THRESHOLD=0.6

# Neuron 4: ResNet-108 - Embedding generation
NEURON4_RESNET_MODEL=resnet108_embedding.pt
NEURON4_EMBEDDING_DIM=512

# Search Configuration
SEARCH_TOP_K=5
EMBEDDING_SIMILARITY_THRESHOLD=0.7
