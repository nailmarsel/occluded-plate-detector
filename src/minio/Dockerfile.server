FROM alpine:3.22

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z

RUN apk add --no-cache ca-certificates curl \
    && case "$TARGETARCH" in \
        amd64) sha256="7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f" ;; \
        arm64) sha256="5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && url="https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-${TARGETARCH}.${MINIO_RELEASE}" \
    && curl --fail --location --retry 3 "$url" --output /usr/local/bin/minio \
    && echo "$sha256  /usr/local/bin/minio" | sha256sum -c - \
    && chmod +x /usr/local/bin/minio \
    && apk del curl

ENTRYPOINT ["minio"]
